{
	// Declare static groups of users.
	"groups": {
		"group:admins": [
			"admin@example.com",
		],
		"group:guests": [
			"guest1@example.com",
			"guest2@example.com",
		],
	},

	// Define access rules.
	"acls": [
		// Admins have full access to all devices and ports.
		{
			"action": "accept",
			"src":    ["group:admins", "autogroup:member"],
			"dst":    ["*:*"],
		},

		// Shared users & Guests can access Pinedash Dashboard, FileBrowser, Suwayomi Manga, and Navidrome.
		{
			"action": "accept",
			"src":    ["group:guests"],
			"dst": [
				"tag:server:80",    // Dashboard HTTP
				"tag:server:443",   // Dashboard HTTPS
				"tag:server:8080",  // Dashboard HTTP (Alternate)
				"tag:server:8081",  // Network Storage (FileBrowser Quantum)
				"tag:server:4567",  // Suwayomi Manga Server
				"tag:server:4533",  // Navidrome Music
			],
		},
	],

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		// Allow all members to SSH into their own devices in check mode.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
}
