{
	// Declare static groups of users.
	"groups": {
		"group:admins": [
			"yatinrajesh77@gmail.com",
			"imyash0722@gmail.com",
		],
		"group:guests": [
			"janakiniharika7@gmail.com",
			"thirukumaran3057@gmail.com",
		],
	},

	// Define access rules.
	"acls": [
		// Admins have full access to all devices and ports.
		{
			"action": "accept",
			"src":    ["group:admins", "autogroup:member"],
			"dst":    ["*:*"],
		},

		// Shared users & Guests can access Pinedash Dashboard, FileBrowser, Suwayomi Manga, and Navidrome.
		{
			"action": "accept",
			"src":    ["group:guests", "janakiniharika7@gmail.com"],
			"dst": [
				"100.112.193.54:80",    // Dashboard HTTP
				"100.112.193.54:443",   // Dashboard HTTPS
				"100.112.193.54:8080",  // Dashboard HTTP (Alternate)
				"100.112.193.54:8081",  // Network Storage (FileBrowser Quantum)
				"100.112.193.54:4567",  // Suwayomi Manga Server
				"100.112.193.54:4533",  // Navidrome Music
			],
		},
	],

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		// Allow all members to SSH into their own devices in check mode.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
}
