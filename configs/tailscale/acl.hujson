{
	// Declare static groups of users.
	"groups": {
		"group:admins": [
			"yatinrajesh77@gmail.com",
		],
		"group:guests": [
			"thirukumaran3057@gmail.com",
		],
	},

	// Define access rules.
	"acls": [
		// Admins can access all devices and ports.
		{
			"action": "accept",
			"src":    ["group:admins"],
			"dst":    ["*:*"],
		},

		// Guests can access the Dashboard (80/443/8080), Network Storage (8081), and Navidrome (4533/4534) on tinarchy.
		{
			"action": "accept",
			"src":    ["group:guests"],
			"dst": [
				"100.67.207.60:80",    // Dashboard HTTP (Zero SSL friction)
				"100.67.207.60:443",   // Dashboard HTTPS (Tailscale TLS)
				"100.67.207.60:8080",  // Dashboard HTTP (Alternate / Proxy Port)
				"100.67.207.60:8081",  // Network Storage (FileBrowser Quantum)
				"100.67.207.60:4533",  // Navidrome (Shared Friend Music Server)
				"100.67.207.60:4534",  // Navidrome (Tin Music Server)
			],
		},
	],

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		// Allow all users to SSH into their own devices in check mode.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
}
