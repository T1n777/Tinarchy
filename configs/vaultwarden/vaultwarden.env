# Vaultwarden Configuration Environment Template
# Upstream Reference: https://github.com/dani-garcia/vaultwarden/wiki/Configuration-overview

# ─── Data & Storage ───
DATA_FOLDER=/var/lib/vaultwarden
# DATABASE_URL=sqlite:///var/lib/vaultwarden/db.sqlite3

# ─── Web Vault UI ───
# Official patched Bitwarden Web Vault (provided by vaultwarden-web package on Arch Linux)
WEB_VAULT_FOLDER=/usr/share/webapps/vaultwarden-web
WEB_VAULT_ENABLED=true

# ─── Network & Routing ───
# Vaultwarden listens locally on 127.0.0.1:8001.
# Nginx terminates HTTPS with SSL certificates on port 8000 and reverse proxies to 127.0.0.1:8001.
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=8001

# The external URL clients and extensions use to connect to this vault.
# NOTE: Replace with your actual domain/Tailscale MagicDNS name and HTTPS port.
DOMAIN=https://tinarchy.tail3dee69.ts.net:8000

# ─── User Registration & Security ───
# Set to false to prevent unauthorized registrations once your account is created.
# (Set to true temporarily when creating your initial account).
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=false
SHOW_PASSWORD_HINT=false

# ─── Built-in Features (Enabled by default in Vaultwarden) ───
# Free TOTP Authenticator Generation, Bitwarden Send, File Attachments
# ATTACHMENT_SIZE_LIMIT=52428800 # 50 MB
# SENDS_ALLOWED=true

# ─── Admin Panel (Optional) ───
# To enable /admin page, generate a secure Argon2 hash with:
#   vaultwarden hash
# and paste the hash below:
# ADMIN_TOKEN='$argon2id$v=19$m=65536,t=3,p=4$...'
