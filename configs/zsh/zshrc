# ==============================================================================
# Pinedash Server Zsh Configuration
# ==============================================================================

# Path to Oh My Zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Set theme
ZSH_THEME="ubunly"

# Ensure user local binaries take precedence
export PATH="$HOME/.local/bin:$PATH"

# ─── Plugins Configuration ───────────────────────────────────────────────────
# Lightweight plugins for fast, responsive terminal startup
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# ─── Low-Latency & Anti-Flicker Settings (SSH Optimized) ─────────────────────
# Async suggestions and constrained buffer lengths eliminate typing lag over SSH
export ZSH_AUTOSUGGEST_USE_ASYNC=1
export ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=30
export ZSH_HIGHLIGHT_MAXLENGTH=200

# Load Oh My Zsh
source "$ZSH/oh-my-zsh.sh"

# ─── Pinedash Light Blue Terminal Palette ────────────────────────────────────
export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=68"

typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=81,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=75,bold'
ZSH_HIGHLIGHT_STYLES[alias]='fg=117,bold'
ZSH_HIGHLIGHT_STYLES[function]='fg=111,bold'
ZSH_HIGHLIGHT_STYLES[path]='fg=153,underline'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=117'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=81'
ZSH_HIGHLIGHT_STYLES[bracket-level-1]='fg=75,bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-2]='fg=81,bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-3]='fg=117,bold'

# ─── Tailscale / Remote SSH Session Persistence (tmux auto-attach) ───────────
# Automatically keep background tasks running even if the terminal closes,
# Wi-Fi drops, or the client device sleeps.
# To bypass tmux in an interactive shell, connect with: NO_AUTO_TMUX=1 ssh ...
if [[ -n "$SSH_CONNECTION" || -n "$SSH_CLIENT" || -n "$SSH_TTY" ]] && \
   [[ -z "$TMUX" ]] && \
   [[ -t 1 ]] && \
   [[ -o interactive ]] && \
   [[ -z "$NO_AUTO_TMUX" ]]; then
    exec tmux new-session -A -s main
fi

# ─── Interactive Startup Banner (Telemetry & Shortcuts) ───────────────────────
if [[ -o interactive ]] && [[ -t 1 ]]; then
    fastfetch
fi

# ─── Helpful Aliases ─────────────────────────────────────────────────────────
alias ff="fastfetch"
alias tmux-keys="fastfetch"
alias shortcuts="fastfetch"
