# ==============================================================================
# Pinedash Server Zsh Configuration
# ==============================================================================

# Path to Oh My Zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Set theme
ZSH_THEME="ubunly"

# Ensure user local binaries take precedence
export PATH="$HOME/.local/bin:$PATH"

# Fallback to xterm-256color if client terminal is missing in terminfo
if [[ -n "$TERM" ]] && ! infocmp "$TERM" >/dev/null 2>&1; then
    export TERM="xterm-256color"
fi

# ─── Plugins Configuration ───────────────────────────────────────────────────
# Lightweight plugins for fast, responsive terminal startup
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# ─── Low-Latency & Anti-Flicker Settings (SSH Optimized) ─────────────────────
# Async suggestions and constrained buffer lengths eliminate typing lag over SSH
export ZSH_AUTOSUGGEST_USE_ASYNC=1
export ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=30
export ZSH_HIGHLIGHT_MAXLENGTH=200

# Load Oh My Zsh
source "$ZSH/oh-my-zsh.sh"

# ─── Matugen Pastel Terminal Palette & Prompt ───────────────────────────────
export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#a08b93"

typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=#ffafd3,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#edb8ce,bold'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#ffafd3,bold'
ZSH_HIGHLIGHT_STYLES[function]='fg=#edb8ce,bold'
ZSH_HIGHLIGHT_STYLES[path]='fg=#94d781,underline'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#edb8ce'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#ffafd3'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#94d781'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#94d781'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=#94d781'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#ffb4ab,bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-1]='fg=#ffafd3,bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-2]='fg=#edb8ce,bold'
ZSH_HIGHLIGHT_STYLES[bracket-level-3]='fg=#94d781,bold'

# Clean pastel prompt matching Matugen aesthetic
PROMPT='%F{#ffafd3}%n%f%F{#a08b93}@%f%F{#edb8ce}%m%f %F{#94d781}%~%f %F{#ffafd3}❯%f '

# ─── Terminal Session Persistence (tmux auto-attach for SSH & Default TTY) ────
# Automatically keep background tasks running and share the exact same session
# across Tailscale SSH and the default physical TTY console.
# To bypass tmux in an interactive shell, run: NO_AUTO_TMUX=1 zsh (or ssh)
if [[ -n "$SSH_CONNECTION" || -n "$SSH_CLIENT" || -n "$SSH_TTY" || "$(tty 2>/dev/null)" =~ ^/dev/tty[0-9]+$ ]] && \
   [[ -z "$TMUX" ]] && \
   [[ -t 1 ]] && \
   [[ -o interactive ]] && \
   [[ -z "$NO_AUTO_TMUX" ]]; then
    exec tmux new-session -A -s main
fi

# ─── Helpful Cheatsheet Aliases ──────────────────────────────────────────────
tmux-keys() {
    cat << 'EOF'
─── ⚡ Persistent SSH / tmux Shortcuts (Prefix: Ctrl+Space) ───
  Detach Session     : Ctrl+Space d
  New Window         : Ctrl+Space c
  Next / Prev Window : Ctrl+Space n / Ctrl+Space p
  Split Vertical     : Ctrl+Space %
  Split Horizontal   : Ctrl+Space "
  Navigate Panes     : Ctrl+Space Left/Right/Up/Down
  Scroll / History   : Mouse Scroll or Ctrl+Space [ (q to exit)
EOF
}
alias shortcuts="tmux-keys"
