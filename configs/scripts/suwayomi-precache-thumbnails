#!/usr/bin/env python3
"""
Suwayomi Multi-Core WebP Thumbnail Pre-Cacher & Optimizer
Proactively generates lightweight, high-DPI WebP thumbnails (340px width, ~40 KB)
for all manga in the Suwayomi library across all CPU threads using ThreadPoolExecutor.

Dual-Tier Storage Architecture:
- Tier 1 (Optimized WebP SSD Store): Permanent high-DPI WebP thumbnails saved to
  /var/lib/suwayomi/cache/optimized_thumbnails/{id}.webp.
- Tier 2 (Static Nginx Fast-Path): Nginx try_files serves optimized WebP files
  via kernel sendfile in < 1 ms, completely bypassing Suwayomi JVM and Python.
- Dynamic Fallback: If a newly added title is requested before this script runs,
  Nginx routes to the Dashboard Optimizer (:8085) to generate the WebP on the fly.
"""
import argparse
import concurrent.futures
import io
import json
import os
import sys
import time
import urllib.request
import urllib.error
from PIL import Image, ImageFile
ImageFile.LOAD_TRUNCATED_IMAGES = True

try:
    from tinarchy.thumbnails import get_suwayomi_auth_header
except ImportError:
    sys.path.append("/home/tin/server-dashboard")
    try:
        from tinarchy.thumbnails import get_suwayomi_auth_header
    except Exception:
        def get_suwayomi_auth_header(): return None

OPTIMIZED_DIR = "/var/lib/suwayomi/cache/optimized_thumbnails"
RAW_CACHE_DIRS = [
    "/var/lib/suwayomi/cache/Tachidesk/thumbnails",
    "/var/lib/suwayomi/downloads/thumbnails",
    "/var/lib/suwayomi/.local/share/Tachidesk/downloads/thumbnails",
    os.path.expanduser("~/.local/share/Tachidesk/downloads/thumbnails"),
]
GRAPHQL_CANDIDATES = [
    "http://127.0.0.1:4566/api/graphql",
    "http://127.0.0.1:4567/manga/api/graphql",
    "http://127.0.0.1:4567/api/graphql",
    "http://127.0.0.1:8080/manga/api/graphql",
]
SUWAYOMI_RAW_URLS = [
    "http://127.0.0.1:4566/api/v1/manga/{id}/thumbnail",
    "http://127.0.0.1:4567/api/v1/manga/{id}/thumbnail",
    "http://127.0.0.1:4567/manga/api/v1/manga/{id}/thumbnail",
]


def optimize_image_data(raw_data: bytes, target_width: int = 340, quality: int = 80) -> bytes:
    """Downscales raw image bytes to an optimized high-DPI WebP thumbnail."""
    with Image.open(io.BytesIO(raw_data)) as img:
        if getattr(img, 'format', '') == 'JPEG':
            try:
                img.draft('RGB', (target_width * 2, int(target_width * 3)))
            except Exception:
                pass

        if img.mode in ('RGBA', 'LA'):
            bg = Image.new('RGB', img.size, (255, 255, 255))
            bg.paste(img, mask=img.split()[-1])
            img = bg
        elif img.mode != 'RGB':
            img = img.convert('RGB')

        w, h = img.size
        if w > target_width:
            new_w = target_width
            new_h = max(1, int(h * (target_width / w)))
            img = img.resize((new_w, new_h), Image.Resampling.BILINEAR)

        buf = io.BytesIO()
        img.save(buf, format='WEBP', quality=quality, method=2)
        return buf.getvalue()


def find_graphql_url() -> str:
    for url in GRAPHQL_CANDIDATES:
        try:
            hdrs = {"Content-Type": "application/json"}
            auth_hdr = get_suwayomi_auth_header()
            if auth_hdr:
                hdrs["Authorization"] = auth_hdr
            req = urllib.request.Request(
                url,
                data=json.dumps({"query": "{ mangas(filter: { inLibrary: { equalTo: true } }) { totalCount } }"}).encode("utf-8"),
                headers=hdrs
            )
            with urllib.request.urlopen(req, timeout=3) as resp:
                if resp.status == 200:
                    data = json.loads(resp.read().decode("utf-8"))
                    if "data" in data:
                        return url
        except Exception:
            pass
    return "http://127.0.0.1:4567/manga/api/graphql"


def get_mangas(graphql_url: str, library_only: bool = True) -> list:
    filter_clause = "(filter: { inLibrary: { equalTo: true } })" if library_only else ""
    query = """
    {
      mangas%s {
        nodes {
          id
          title
          inLibrary
        }
      }
    }
    """ % filter_clause
    hdrs = {"Content-Type": "application/json"}
    auth_hdr = get_suwayomi_auth_header()
    if auth_hdr:
        hdrs["Authorization"] = auth_hdr
    req = urllib.request.Request(
        graphql_url,
        data=json.dumps({"query": query}).encode("utf-8"),
        headers=hdrs
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data.get("data", {}).get("mangas", {}).get("nodes", [])
    except Exception as e:
        print(f"[ERROR] Failed to query Suwayomi GraphQL: {e}", file=sys.stderr)
        return []


def find_raw_cover(manga_id: int) -> bytes | None:
    """Finds raw cover on disk or fetches directly from Suwayomi core."""
    for d in RAW_CACHE_DIRS:
        if not os.path.isdir(d):
            continue
        for ext in ('.webp', '.jpg', '.jpeg', '.png'):
            fpath = os.path.join(d, f"{manga_id}{ext}")
            if os.path.isfile(fpath) and os.path.getsize(fpath) > 0:
                try:
                    with open(fpath, "rb") as f:
                        return f.read()
                except Exception:
                    pass

    # Fetch from Suwayomi core
    auth_hdr = get_suwayomi_auth_header()
    req_hdrs = {"User-Agent": "Suwayomi-PreCacher/2.0"}
    if auth_hdr:
        req_hdrs["Authorization"] = auth_hdr
    for tmpl in SUWAYOMI_RAW_URLS:
        try:
            url = tmpl.format(id=manga_id)
            req = urllib.request.Request(url, headers=req_hdrs)
            with urllib.request.urlopen(req, timeout=5) as resp:
                if resp.status == 200:
                    data = resp.read()
                    if data:
                        return data
        except Exception:
            pass

    return None


def process_manga_cover(manga: dict, target_width: int = 340, quality: int = 80, force: bool = False) -> dict:
    """Processes a single manga thumbnail, returning stats dict."""
    manga_id = manga["id"]
    title = manga.get("title", f"Manga #{manga_id}")
    dest_path = os.path.join(OPTIMIZED_DIR, f"{manga_id}.webp")

    if not force and os.path.isfile(dest_path) and os.path.getsize(dest_path) > 0:
        return {
            "id": manga_id,
            "title": title,
            "status": "cached",
            "size": os.path.getsize(dest_path),
            "raw_size": 0,
            "elapsed": 0.0
        }

    start = time.time()
    raw_data = find_raw_cover(manga_id)
    if not raw_data:
        return {
            "id": manga_id,
            "title": title,
            "status": "missing_source",
            "size": 0,
            "raw_size": 0,
            "elapsed": time.time() - start
        }

    raw_len = len(raw_data)
    try:
        webp_data = optimize_image_data(raw_data, target_width=target_width, quality=quality)
        tmp_path = f"{dest_path}.tmp.{os.getpid()}.{manga_id}"
        with open(tmp_path, "wb") as f:
            f.write(webp_data)
        os.chmod(tmp_path, 0o644)
        os.replace(tmp_path, dest_path)
        elapsed = time.time() - start
        return {
            "id": manga_id,
            "title": title,
            "status": "optimized",
            "size": len(webp_data),
            "raw_size": raw_len,
            "elapsed": elapsed
        }
    except Exception as e:
        return {
            "id": manga_id,
            "title": title,
            "status": f"error: {e}",
            "size": 0,
            "raw_size": raw_len,
            "elapsed": time.time() - start
        }


def main():
    parser = argparse.ArgumentParser(description="Suwayomi Multi-Core WebP Thumbnail Pre-Cacher")
    parser.add_argument("--all", action="store_true", help="Pre-cache all manga in database, not just library")
    parser.add_argument("--force", action="store_true", help="Re-optimize even if already cached on disk")
    parser.add_argument("--id", type=int, help="Pre-cache a specific manga ID")
    parser.add_argument("--workers", type=int, default=8, help="Number of parallel worker threads (default: 8)")
    parser.add_argument("--width", type=int, default=340, help="Thumbnail max width (default: 340)")
    parser.add_argument("--quality", type=int, default=80, help="WebP compression quality (default: 80)")
    args = parser.parse_args()

    os.makedirs(OPTIMIZED_DIR, exist_ok=True)

    print("=== Suwayomi Multi-Core WebP Thumbnail Pre-Cacher ===")
    print(f"Target Directory: {OPTIMIZED_DIR}")
    print(f"Worker Threads:   {args.workers}")
    print(f"Target Width:     {args.width}px | WebP Quality: {args.quality}")

    if args.id:
        print(f"\nProcessing Single Manga ID: {args.id}")
        res = process_manga_cover({"id": args.id, "title": f"Manga #{args.id}"}, target_width=args.width, quality=args.quality, force=args.force)
        if res["status"] == "optimized":
            savings = ((res["raw_size"] - res["size"]) / res["raw_size"] * 100) if res["raw_size"] > 0 else 0
            print(f"  ✓ Optimized ID {args.id}: {res['raw_size']/1024:.1f} KB -> {res['size']/1024:.1f} KB ({savings:.1f}% reduction) in {res['elapsed']*1000:.1f}ms")
        elif res["status"] == "cached":
            print(f"  ✓ ID {args.id} already cached ({res['size']/1024:.1f} KB).")
        else:
            print(f"  ✗ ID {args.id} failed: {res['status']}", file=sys.stderr)
        sys.exit(0 if res["status"] in ("optimized", "cached") else 1)

    graphql_url = find_graphql_url()
    target_desc = "All Database Entries" if args.all else "Library Only"
    print(f"Target Scope:     {target_desc} ({graphql_url})")

    mangas = get_mangas(graphql_url, library_only=not args.all)
    if not mangas:
        print("Suwayomi server unreachable or library empty. Gracefully skipping thumbnail pre-caching.")
        sys.exit(0)

    total_count = len(mangas)
    print(f"Found {total_count} manga entries. Beginning parallel optimization...\n")

    overall_start = time.time()
    cached_count = 0
    optimized_count = 0
    failed_count = 0
    total_raw_bytes = 0
    total_opt_bytes = 0

    with concurrent.futures.ThreadPoolExecutor(max_workers=args.workers) as executor:
        future_to_manga = {
            executor.submit(process_manga_cover, m, args.width, args.quality, args.force): m
            for m in mangas
        }

        for idx, future in enumerate(concurrent.futures.as_completed(future_to_manga), 1):
            res = future.result()
            m_id = res["id"]
            title = res["title"]
            status = res["status"]

            if status == "cached":
                cached_count += 1
            elif status == "optimized":
                optimized_count += 1
                total_raw_bytes += res["raw_size"]
                total_opt_bytes += res["size"]
                savings = ((res["raw_size"] - res["size"]) / res["raw_size"] * 100) if res["raw_size"] > 0 else 0
                print(f"  [{idx:3d}/{total_count:3d}] ✓ ID {m_id:3d} | {res['raw_size']/1024:6.1f} KB -> {res['size']/1024:4.1f} KB (-{savings:4.1f}%) in {res['elapsed']*1000:5.1f}ms | {title[:35]}")
            else:
                failed_count += 1
                print(f"  [{idx:3d}/{total_count:3d}] ✗ ID {m_id:3d} | {status} | {title[:35]}", file=sys.stderr)

    total_time = time.time() - overall_start
    print("\n" + "=" * 55)
    print(f"Optimization Summary across {args.workers} Cores:")
    print(f"  Total Manga in Scope:   {total_count}")
    print(f"  Already Cached:         {cached_count}")
    print(f"  Newly Optimized:        {optimized_count}")
    print(f"  Errors / Missing:       {failed_count}")
    if total_raw_bytes > 0:
        total_savings = (total_raw_bytes - total_opt_bytes) / total_raw_bytes * 100
        print(f"  Raw Source Data:        {total_raw_bytes / (1024*1024):.2f} MB")
        print(f"  Optimized WebP Data:    {total_opt_bytes / (1024*1024):.2f} MB")
        print(f"  Total Bandwidth Saved:  {total_savings:.1f}%")
    print(f"  Completed in:           {total_time:.2f} seconds")
    print("=" * 55)


if __name__ == "__main__":
    main()
