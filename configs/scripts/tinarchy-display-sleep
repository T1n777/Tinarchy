#!/usr/bin/env python3
"""
Tinarchy Headless Server Display Sleep & Inactivity Daemon
- Monitors physical keyboard/touchpad/mouse input via /dev/input/event*
- Automatically powers down display backlight (bl_power=4) after inactivity timeout (default: 120s)
- Instantly wakes display (bl_power=0) on any physical keypress, mouse click, or touchpad touch
- Handles laptop lid closed state (keeps backlight off while closed)
- Supports 'off', 'on', 'toggle', 'status' CLI arguments
- Consumes 0.0% CPU (blocked in kernel epoll) and < 5MB RAM
"""

import os
import sys
import glob
import time
import signal
import selectors

TIMEOUT_SECONDS = int(os.environ.get('DISPLAY_SLEEP_TIMEOUT', '120'))

def find_backlight_files():
    return glob.glob('/sys/class/backlight/*/bl_power')

def is_lid_closed():
    for f in glob.glob('/proc/acpi/button/lid/*/state'):
        try:
            with open(f, 'r') as fp:
                if 'closed' in fp.read():
                    return True
        except Exception:
            pass
    return False

def get_screen_state():
    """Returns True if screen is ON (bl_power == 0), False if OFF (bl_power != 0)"""
    for f in find_backlight_files():
        try:
            with open(f, 'r') as fp:
                val = fp.read().strip()
                return (val == '0')
        except Exception:
            pass
    return True

def set_screen_power(power_on: bool):
    target_val = '0' if power_on else '4'
    for f in find_backlight_files():
        try:
            with open(f, 'w') as fp:
                fp.write(target_val + '\n')
        except Exception:
            pass

    # Blank/poke virtual consoles for clean terminal state (if accessible)
    flag = '--blank poke' if power_on else '--blank force'
    for tty in glob.glob('/dev/tty[1-6]'):
        try:
            if os.access(tty, os.R_OK | os.W_OK):
                os.system(f'/usr/bin/setterm --term linux {flag} < {tty} > {tty} 2>/dev/null')
        except Exception:
            pass

def toggle_screen():
    current_on = get_screen_state()
    set_screen_power(not current_on)

def main():
    prog_name = os.path.basename(sys.argv[0])
    arg = sys.argv[1] if len(sys.argv) > 1 else ""

    if prog_name == 'screen-off' or arg == 'off':
        set_screen_power(False)
        sys.exit(0)
    elif prog_name == 'screen-on' or arg == 'on':
        set_screen_power(True)
        sys.exit(0)
    elif prog_name == 'screen-toggle' or arg == 'toggle':
        toggle_screen()
        sys.exit(0)
    elif arg == 'status':
        print("ON" if get_screen_state() else "OFF")
        sys.exit(0)

    # ─── Daemon Mode ──────────────────────────────────────────────────────────
    sel = selectors.DefaultSelector()
    registered = 0

    for dev in sorted(glob.glob('/dev/input/event*')):
        try:
            fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
            sel.register(fd, selectors.EVENT_READ, dev)
            registered += 1
        except Exception:
            pass

    last_input_time = time.time()
    screen_is_on = get_screen_state()

    def handle_sigusr1(signum, frame):
        nonlocal last_input_time, screen_is_on
        toggle_screen()
        screen_is_on = get_screen_state()
        if screen_is_on:
            last_input_time = time.time()

    signal.signal(signal.SIGUSR1, handle_sigusr1)

    while True:
        try:
            now = time.time()
            events = sel.select(timeout=2.0)

            if events:
                for key, _ in events:
                    try:
                        os.read(key.fd, 4096)
                    except Exception:
                        pass

                last_input_time = now

                # If screen was off and lid is not closed, wake it up immediately
                if not screen_is_on and not is_lid_closed():
                    set_screen_power(True)
                    screen_is_on = True
            else:
                # Inactivity check
                if screen_is_on and (now - last_input_time >= TIMEOUT_SECONDS):
                    set_screen_power(False)
                    screen_is_on = False

            # Keep screen off if lid is closed
            if is_lid_closed() and screen_is_on:
                set_screen_power(False)
                screen_is_on = False

        except (KeyboardInterrupt, SystemExit):
            break
        except Exception:
            time.sleep(2)

    set_screen_power(True)

if __name__ == '__main__':
    main()
