[Unit]
Description=Tinarchy Server Management Control Center
Documentation=https://github.com/T1n777/Tinarchy
After=network.target tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
User=root
WorkingDirectory=/usr/share/tinarchy
ExecStart=/usr/bin/python3 /usr/share/tinarchy/server.py
Restart=always
RestartSec=3
EnvironmentFile=-/etc/tinarchy/tinarchy.env

[Install]
WantedBy=multi-user.target
Alias=server-dashboard.service
