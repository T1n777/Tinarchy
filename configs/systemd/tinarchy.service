[Unit]
Description=Tinarchy Server Management Dashboard
After=network.target tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
User=tin
WorkingDirectory=/home/tin/server-dashboard
ExecStart=/usr/bin/python3 /home/tin/server-dashboard/server.py
Restart=always
RestartSec=5
EnvironmentFile=-/home/tin/server-dashboard/.env

[Install]
WantedBy=multi-user.target
