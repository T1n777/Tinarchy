[Unit]
Description=Tinarchy Display Inactivity Sleep & Powerdown Daemon
Documentation=https://github.com/T1n777/Tinarchy
After=multi-user.target

[Service]
Type=simple
Environment="DISPLAY_SLEEP_TIMEOUT=60"
ExecStart=/usr/local/bin/tinarchy-display-sleep
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
