[Unit]
Description=FileBrowser Quantum Web File Manager
After=network.target

[Service]
Type=simple
User=tin
Group=tin
WorkingDirectory=/home/tin
ExecStartPre=+/usr/bin/ln -sfn /home/tin/.local/bin/filebrowser-quantum /usr/local/bin/filebrowser-quantum
ExecStartPre=/usr/local/bin/tinarchy-drive-sync
ExecStart=/home/tin/.local/bin/filebrowser-quantum -c /etc/filebrowser/config.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
