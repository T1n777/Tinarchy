# ==============================================================================
# Tinarchy Server Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables to customize your server.

# ─── Instance Identity & Branding ─────────────────────────────────────────────
# Name of the project/suite (e.g. "Tinarchy", "Pinedash", "MyHomelab")
PROJECT_NAME="Tinarchy"

# Display name for this specific server (leave blank to auto-detect system hostname)
SERVER_NAME=""

# Subtitle shown below server name in headers and telemetry
BRANDING_SUBTITLE="Server Control Center"

# Primary icon / emoji for navigation bar and badges
APP_ICON="🍍"

# ─── Network & Binding ────────────────────────────────────────────────────────
# Internal HTTP port for the Python dashboard backend
PORT=8085

# Bind interface (127.0.0.1 for local/reverse-proxied, 0.0.0.0 for public)
HOST="127.0.0.1"

# Optional Tailscale IP override (auto-detected via `tailscale ip -4` if left blank)
TAILSCALE_IP=""

# Optional Tailscale MagicDNS domain override (e.g. "my-station.tailnet.ts.net")
TAILSCALE_DOMAIN=""

# Default SSH username used in interactive setup guides (leave blank to auto-detect)
SSH_USER=""

# ─── Security & Authentication ────────────────────────────────────────────────
# Dashboard Web Admin / Settings password
ADMIN_PASSWORD="changeme"

# Guest login password for restricted portal view
GUEST_PASSWORD="changeme"

# Primary owner email (matches Tailscale Whois identity)
OWNER_EMAIL=""

# ─── Integrated Service Ports & Feature Toggles ─────────────────────────────
ENABLE_SUWAYOMI=true
SUWAYOMI_PORT=4567

ENABLE_JELLYFIN=true
JELLYFIN_PORT=8096

ENABLE_SYNCTHING=true
SYNCTHING_PORT=8384

ENABLE_TOR=true
TOR_SOCKS_PORT=9050

ENABLE_TAILSCALE_SSH=true
SSH_PORT=22

# ─── Additional Modular Services ─────────────────────────────────────────────
# Set to "true" to activate SyncYomi manga synchronization service & dashboard tile
ENABLE_SYNCYOMI=false
SYNCYOMI_PORT=8282

# Set to "true" to activate FileBrowser Quantum web file manager
ENABLE_FILEBROWSER=false
FILEBROWSER_PORT=8081
FILEBROWSER_SYSTEMD=filebrowser-quantum

# Set to "true" to activate CouchDB Obsidian LiveSync backend
ENABLE_COUCHDB=false
COUCHDB_PORT=5984

# ─── Storage & Paths ──────────────────────────────────────────────────────────
# Wallpaper directory (defaults to $HOME/Wall or public/Wallpapers)
WALLPAPER_DIR=""

# Unified drive storage directory (defaults to $HOME/drive)
STORAGE_DIR=""

# Drive synchronization binary (defaults to /usr/local/bin/tinarchy-drive-sync)
DRIVE_SYNC_BIN=""
